# Copy to .env and adjust for your environment
PORT=3001
NODE_ENV=development

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=hrms
DB_PASSWORD=hrms123
DB_NAME=hrms

# Auth
# Use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-strong-random-secret-at-least-32-chars
JWT_EXPIRES=12h

# Comma-separated list of allowed CORS origins (browser frontends)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Optional Redis for cross-instance presence/typing state
# REDIS_URL=redis://127.0.0.1:6379
